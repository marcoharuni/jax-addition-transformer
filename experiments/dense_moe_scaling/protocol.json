  "dataset": {
    "domain": "all ordered pairs (a, b) with 0 <= a,b <= 999",
    "pair_id": "1000 * a + b",
    "split_sizes": {
      "train": 200000,
      "validation": 20000,
      "test": 780000
    },
    "stratification": "operand lengths and carry bits ordered units-tens-hundreds; deterministic largest-remainder allocation within strata",
    "training_sampler": "50% uniform over the fixed train pool and 50% uniform over non-empty train strata, with replacement"
  },
  "representation": {
    "vocabulary": "0123456789 +=",
    "vocabulary_size": 13,
    "full_record_tokens": 16,
    "model_input_tokens": 15,
