{
  "model": {
    "n_layers": 2,
    "d_model": 128,
    "n_heads": 2,
    "n_kv_heads": 2,
    "d_ff": 992,
    "max_input_length": 15,
    "vocab_size": 13,
    "norm_type": "layernorm",
    "position_type": "learned",
    "ffn_type": "gelu",
    "attention_type": "mha",
    "use_bias": false,
    "tie_embeddings": true,
    "compute_dtype": "float16",
    "parameter_dtype": "float32",
    "norm_epsilon": 1e-05,
    "rope_base": 10000.0,
    "init_scale": 0.02
  },
  "task": {
    "max_digits": 3
  },
  "optimizer": {
    "name": "adamw",
    "peak_learning_rate": 0.001,
    "initial_learning_rate": 0.0,
    "final_learning_rate": 0.0001,
    "warmup_steps": 10,
    "total_steps": 100,
    "beta1": 0.9,
    "beta2": 0.99,
    "epsilon": 1e-08,
    "weight_decay": 0.1,
    "clip_global_norm": 1.0,
    "momentum": 0.9
  },
  "training": {
    "seed": 2026,
    "train_pairs": 200000,
    "validation_pairs": 20000,
    "test_pairs": 780000,
    "batch_size": 2048,
    "evaluation_batch_size": 4000,
    "max_steps": 100,
    "validation_interval": 100,
    "logging_interval": 25,
    "checkpoint_interval": 100
  }
}
